# Dependencies — reinstalled cleanly inside the image via `npm ci`.
node_modules
**/node_modules

# Build outputs — regenerated by `npm run build` in the builder stage.
**/dist

# VCS and local tooling
.git
.gitignore
.github
.claude
.vscode

# Secrets and local env — never bake into an image.
# The ** forms are load-bearing: a bare `.env` matches ONLY the repo root, so
# `server/.env` (which exists in a normal dev checkout) was still being copied
# in by `COPY . .` and shipped in the pushed image. Verified before the fix.
.env
.env.*
**/.env
**/.env.*
!.env.example
**/*.pem
**/*.key

# Docker + compose (not needed inside the build context)
Dockerfile
.dockerignore
docker-compose.yml

# Docs and design vault — not needed at runtime, keeps context small.
docs

# Logs and misc
*.log
npm-debug.log*
