# --- Core ---
PORT=4000
APP_URL=http://localhost:5174
API_URL=http://localhost:4000
DATABASE_URL=postgres://codeaudit:codeaudit@localhost:5433/codeaudit
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-in-production

# --- Production / AWS (leave blank for local dev) ---
# Encrypt the Postgres connection (AWS RDS): set to "require".
DATABASE_SSL=
# Encrypt the Redis connection (ElastiCache in-transit encryption): "true".
# Not needed if REDIS_URL already uses the rediss:// scheme.
REDIS_TLS=
# Absolute path (inside the container) to the built web bundle for the API to
# serve same-origin. Set by the Dockerfile; leave blank for local Vite dev.
WEB_DIST_DIR=

# --- LLM (Grok / xAI) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=llama-3.3-70b-versatile
# Tried when XAI_MODEL is rate-limited or decommissioned. Groq meters tokens
# per model, so this is a second independent budget, not a share of the same one.
XAI_FALLBACK_MODEL=openai/gpt-oss-120b

# --- GitHub App (M4) ---
GITHUB_APP_ID=
# The App's URL slug: github.com/settings/apps/<slug>. Used for the install link.
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative to the file path above: the PEM contents directly, for AWS
# Secrets Manager / ECS env injection. Newlines may be "\n"-escaped. Wins over
# the path when set.
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- Stripe (M5, test mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
