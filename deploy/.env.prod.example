# Copy to `.env` NEXT TO docker-compose.prod.yml on the EC2 host and fill in.
# This file lives only on the server. Never commit the filled-in copy, and note
# that .dockerignore keeps every .env out of the image by design.
#
#   chmod 600 .env
#
# Generate the two secrets below with:
#   openssl rand -hex 32

# --- Image ---
# The ECR URI you pushed, including the tag.
IMAGE=<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/codeorion:latest

# --- Datastore credentials (used by compose to build DATABASE_URL) ---
POSTGRES_PASSWORD=

# --- Core ---
# Until you attach a domain these are the instance's public URL, e.g.
# http://12.34.56.78 . Both must be the address a browser actually uses:
# APP_URL drives CORS, and API_URL is what OAuth redirects come back to.
APP_URL=
API_URL=
JWT_SECRET=

# Serves the built SPA from inside the image. Do not change.
WEB_DIST_DIR=/app/web/dist

# TLS to Postgres/Redis. Both stay OFF here: those hops never leave the
# compose network. Turn on only if you move to RDS / ElastiCache.
# DATABASE_SSL=require
# REDIS_TLS=true

# --- LLM (optional; scans run without it, with reduced analysis) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini

# --- GitHub App (optional; needed for private repos, PR comments, OAuth login)
# Requires HTTPS on a real domain — GitHub will not call back to a bare IP.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# PEM contents on ONE line with literal \n between lines; the server converts
# them back. Avoids mounting a key file into the container.
GITHUB_APP_PRIVATE_KEY=

# --- Stripe (optional; billing. Also requires HTTPS for webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
